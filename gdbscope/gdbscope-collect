#!/bin/bash
#
# gdbscope-collect — bundle a core dump with its executable, all shared
# libraries, and their debuginfo + gdb auto-load scripts into a portable
# tarball for off-site analysis.
#
# Run this on the machine where the core dump was produced. The output tarball
# can be copied to a dev machine and analysed with:
#
#   tar xf coredump-<name>-<ts>.tar.gz
#   gdbscope -e <sysroot>/path/to/executable -c <sysroot>/path/to/core \
#            --sysroot <sysroot>
#
# For interpreted targets (e.g. a Python service) pass the *interpreter* as -e,
# not the script — a core belongs to the process (python3), not the .py. If you
# pass a script, the collector detects the real interpreter from the core and
# bundles that, keeping your script as an included source file.
#
# Bundling debuginfo is what lets language helpers work off-site — e.g. CPython's
# py-bt/py-list/py-locals (which need libpython's debug symbols + its
# pythonX.Y-gdb.py auto-load script). Install the relevant *-debuginfo packages
# on THIS machine before collecting.
#
# Usage:
#   gdbscope-collect -e /path/to/executable -c /path/to/core
#   gdbscope-collect -e /usr/bin/python3 -c /path/to/core -a /opt/app/src
#   gdbscope-collect -e /path/to/executable -c /path/to/core -o bundle.tar.gz

set -euo pipefail

usage() {
    cat <<'EOF'
Usage: gdbscope-collect -e EXECUTABLE -c COREFILE [-a PATH]... [-o OUTPUT] [-D]

Bundle a core dump with its executable, shared libraries, debuginfo, and gdb
auto-load scripts into a portable tarball for off-site analysis with
gdbscope --sysroot.

Options:
  -e EXECUTABLE   Path to the executable that produced the core dump. For an
                  interpreted target, pass the interpreter (e.g. /usr/bin/python3);
                  if you pass a script, the real interpreter is detected from the core.
  -c COREFILE     Path to the core dump file
  -a PATH         Also include this file or directory (repeatable) — e.g. the
                  application's source tree so interpreted source resolves.
  -o OUTPUT       Output tarball path (default: coredump-<name>-<timestamp>.tar.gz)
  -D              Skip debuginfo collection (smaller, but language helpers won't work)
  -h              Show this help

Example (Python service core):
  gdbscope-collect -e /usr/bin/python3 -c /var/cores/core.12345 \
      -a /opt/OPENca/openCA-7.3.74.2/web/SonarSOAP
  scp coredump-python3-*.tar.gz dev-machine:~/

  # On the dev machine:
  tar xf coredump-python3-*.tar.gz
  gdbscope -e sysroot/usr/bin/python3 -c sysroot/core.12345 --sysroot sysroot
EOF
    exit "${1:-0}"
}

EXECUTABLE=""
COREFILE=""
OUTPUT=""
COLLECT_DEBUG=1
INCLUDES=()

while getopts "e:c:a:o:Dh" opt; do
    case "$opt" in
        e) EXECUTABLE="$OPTARG" ;;
        c) COREFILE="$OPTARG" ;;
        a) INCLUDES+=("$OPTARG") ;;
        o) OUTPUT="$OPTARG" ;;
        D) COLLECT_DEBUG=0 ;;
        h) usage 0 ;;
        *) usage 1 ;;
    esac
done

if [[ -z "$EXECUTABLE" || -z "$COREFILE" ]]; then
    echo "Error: both -e EXECUTABLE and -c COREFILE are required" >&2
    usage 1
fi

if [[ ! -f "$EXECUTABLE" ]]; then
    echo "Error: executable not found: $EXECUTABLE" >&2
    exit 1
fi

if [[ ! -f "$COREFILE" ]]; then
    echo "Error: core file not found: $COREFILE" >&2
    exit 1
fi

core_abs=$(readlink -f "$COREFILE")

# ---------------------------------------------------------------------------
# Determine the real ELF executable.
#
# If -e is a script (or otherwise not an ELF executable), the core actually
# belongs to the interpreter. Detect it from the core's "generated by" banner
# and bundle that as the executable, keeping the original script as an include.
# ---------------------------------------------------------------------------
orig_exe_abs=$(readlink -f "$EXECUTABLE")
EXE_ELF="$orig_exe_abs"

if ! file -b "$orig_exe_abs" 2>/dev/null | grep -q 'ELF'; then
    echo "Note: '$EXECUTABLE' is not an ELF executable — detecting interpreter from the core."
    if command -v gdb &>/dev/null; then
        genline=$(gdb -q -batch -c "$core_abs" 2>&1 \
            | grep -oP "generated by \`\K[^']+" | head -1 || true)
        interp=$(awk '{print $1}' <<<"$genline")
        # Resolve to an absolute path.
        if [[ -n "$interp" ]]; then
            if [[ "$interp" != /* ]]; then
                interp=$(command -v "$interp" 2>/dev/null || echo "$interp")
            fi
            interp=$(readlink -f "$interp" 2>/dev/null || echo "$interp")
        fi
    fi
    if [[ -n "${interp:-}" && -f "$interp" ]] && file -b "$interp" | grep -q 'ELF'; then
        echo "Detected interpreter: $interp"
        EXE_ELF="$interp"
        # Keep the original script as bundled source.
        INCLUDES+=("$orig_exe_abs")
    else
        echo "Warning: could not detect an ELF interpreter from the core." >&2
        echo "         Re-run with -e pointing at the interpreter (e.g. /usr/bin/python3)." >&2
    fi
fi

# Default output name (based on the real executable)
if [[ -z "$OUTPUT" ]]; then
    basename=$(basename "$EXE_ELF")
    timestamp=$(date +%Y%m%d-%H%M%S)
    OUTPUT="coredump-${basename}-${timestamp}.tar.gz"
fi

TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"' EXIT

SYSROOT="$TMPDIR/sysroot"
mkdir -p "$SYSROOT"

# Copy an absolute path into the sysroot, preserving its full directory
# structure and any symlinks (cp --parents strips the leading slash for the
# destination join).
copyp() {
    local p="$1"
    [[ -e "$p" || -L "$p" ]] || return 0
    cp -a --parents "$p" "$SYSROOT/" 2>/dev/null || true
}

DEBUG_COUNT=0

# Collect the separate debuginfo (and any gdb auto-load helper) for an ELF
# file, via its build-id under /usr/lib/debug/.build-id. Returns 0 if found.
collect_debug_for() {
    [[ "$COLLECT_DEBUG" -eq 1 ]] || return 1
    local f="$1" bid bpath real
    bid=$(file "$f" 2>/dev/null | grep -oP 'BuildID\[sha1\]=\K[0-9a-f]+' || true)
    [[ -n "$bid" ]] || return 1
    bpath="/usr/lib/debug/.build-id/${bid:0:2}/${bid:2}.debug"
    [[ -e "$bpath" ]] || return 1

    copyp "$bpath"                 # the build-id symlink
    real=$(readlink -f "$bpath")
    copyp "$real"                  # the actual .debug file

    # gdb auto-load scripts (e.g. libpython3.9.so.1.0-<nvr>.debug-gdb.py)
    [[ -e "${real}-gdb.py" ]] && copyp "${real}-gdb.py"

    DEBUG_COUNT=$((DEBUG_COUNT + 1))
    echo "  + debuginfo: $(basename "$real")"
    return 0
}

# Copy any gdb auto-load script shipped for a library under
# /usr/share/gdb/auto-load (e.g. libstdc++'s pretty-printers).
collect_autoload_for() {
    local lib_real="$1" al
    for al in /usr/share/gdb/auto-load"${lib_real}"-gdb.py \
              /usr/share/gdb/auto-load"${lib_real}".py; do
        [[ -e "$al" ]] && copyp "$al"
    done
    return 0
}

# ---------------------------------------------------------------------------
# Executable + core
# ---------------------------------------------------------------------------
mkdir -p "$SYSROOT/$(dirname "$EXE_ELF")"
cp "$EXE_ELF" "$SYSROOT/$EXE_ELF"
echo "Collected: $EXE_ELF"
collect_debug_for "$EXE_ELF" || true

cp "$core_abs" "$SYSROOT/$(basename "$core_abs")"
echo "Collected: $core_abs"

# ---------------------------------------------------------------------------
# Shared libraries (from ldd, the core's notes, and gdb's shared list)
# ---------------------------------------------------------------------------
collect_libs() {
    if command -v ldd &>/dev/null; then
        ldd "$EXE_ELF" 2>/dev/null | awk '/=>/ {print $3}' | grep -v 'not found' || true
    fi
    if command -v eu-readelf &>/dev/null; then
        eu-readelf -n "$core_abs" 2>/dev/null | grep -oP '/\S+\.so[.\d]*' || true
    elif command -v readelf &>/dev/null; then
        readelf -n "$core_abs" 2>/dev/null | grep -oP '/\S+\.so[.\d]*' || true
    fi
    if command -v gdb &>/dev/null; then
        gdb -batch -ex "set sysroot /" -ex "info shared" \
            "$EXE_ELF" "$core_abs" 2>/dev/null \
            | awk '/^0x/ || /^\t/ {print $NF}' \
            | grep '/' || true
    fi
}

libs=$(collect_libs | sort -u)

for lib in $libs; do
    if [[ -f "$lib" ]]; then
        lib_real=$(readlink -f "$lib")
        mkdir -p "$SYSROOT/$(dirname "$lib")"

        if [[ ! -f "$SYSROOT/$lib_real" ]]; then
            mkdir -p "$SYSROOT/$(dirname "$lib_real")"
            cp "$lib_real" "$SYSROOT/$lib_real"
        fi
        if [[ "$lib" != "$lib_real" && ! -e "$SYSROOT/$lib" ]]; then
            ln -sf "$lib_real" "$SYSROOT/$lib"
        fi

        echo "Collected: $lib"
        collect_debug_for "$lib_real" || true
        collect_autoload_for "$lib_real"
    fi
done

# Also grab the dynamic linker
for ld in /lib64/ld-linux-x86-64.so.2 /lib/ld-linux-x86-64.so.2 /lib/ld-linux.so.2; do
    if [[ -f "$ld" ]]; then
        ld_real=$(readlink -f "$ld")
        mkdir -p "$SYSROOT/$(dirname "$ld")"
        if [[ ! -f "$SYSROOT/$ld_real" ]]; then
            mkdir -p "$SYSROOT/$(dirname "$ld_real")"
            cp "$ld_real" "$SYSROOT/$ld_real"
        fi
        if [[ "$ld" != "$ld_real" && ! -e "$SYSROOT/$ld" ]]; then
            ln -sf "$ld_real" "$SYSROOT/$ld"
        fi
        echo "Collected: $ld"
    fi
done

# ---------------------------------------------------------------------------
# Extra includes (application source trees, etc.)
# ---------------------------------------------------------------------------
for inc in "${INCLUDES[@]:-}"; do
    [[ -n "$inc" ]] || continue
    inc_abs=$(readlink -f "$inc" 2>/dev/null || echo "$inc")
    if [[ -e "$inc_abs" ]]; then
        copyp "$inc_abs"
        echo "Included: $inc_abs"
    else
        echo "Warning: include not found: $inc" >&2
    fi
done

# ---------------------------------------------------------------------------
# Summary + tarball
# ---------------------------------------------------------------------------
lib_count=$(find "$SYSROOT" -name '*.so*' -type f | wc -l)
total_size=$(du -sh "$SYSROOT" | cut -f1)

echo ""
echo "Bundled $lib_count libraries and $DEBUG_COUNT debuginfo file(s) ($total_size total)"
if [[ "$COLLECT_DEBUG" -eq 1 && "$DEBUG_COUNT" -eq 0 ]]; then
    echo "Warning: no debuginfo was found. Language helpers (e.g. py-bt) and full" >&2
    echo "         symbolication will NOT work off-site. Install the relevant" >&2
    echo "         *-debuginfo packages on this machine and re-run." >&2
fi

tar czf "$OUTPUT" -C "$TMPDIR" sysroot

final_size=$(du -sh "$OUTPUT" | cut -f1)
echo "Created: $OUTPUT ($final_size)"
echo ""
echo "To analyse on your dev machine:"
echo "  tar xf $OUTPUT"
echo "  gdbscope -e sysroot${EXE_ELF} -c sysroot/$(basename "$core_abs") --sysroot sysroot"
